{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python3 tests/*)",
      "Bash(./tests/*)",
      "Bash(cppcheck:*)",
      "Bash(shellcheck:*)",
      "Bash(valgrind:*)"
    ]
  }
}
